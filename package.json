{
  "name": "nuvio-tizenbrew-local",
  "version": "1.2.10",
  "description": "Nuvio TV 1.2.10 bundled inside the module (no hosted server), for TizenBrew on older Samsung TVs",
  "packageType": "app",
  "appName": "Nuvio TV (lokálne)",
  "appPath": "app/index.html?source=tizenbrew&wrapper=tizen",
  "keys": [
    "MediaPlay",
    "MediaPause",
    "MediaPlayPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackPrevious",
    "MediaTrackNext"
  ],
  "evaluateScriptOnDocumentStart": false,
  "license": "GPL-3.0",
  "files": ["app", "README.md", "LICENSE"]
}
